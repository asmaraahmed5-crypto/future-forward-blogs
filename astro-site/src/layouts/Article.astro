---
import Base from './Base.astro';
import { COVERS, PHOTOS, ALT } from '../plugins/media.mjs';
const { entry, headings, minutes, noindex, faq, file, children = [] } = Astro.props;
const d = entry.data;
const SITE = 'https://futureforwardstudios.com';
const canonical = d.canonical_url || SITE + '/' + d.slug.replace(/^\/|\/$/g, '') + '/';
const h1 = headings.find((h: any) => h.depth === 1)?.text ?? d.seo_title;
const toc = headings.filter((h: any) => h.depth === 2);
const cover = COVERS[file];
const jsonld: object[] = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: h1, item: canonical }] },
  { '@context': 'https://schema.org', '@type': 'Article', headline: h1, description: d.meta_description, mainEntityOfPage: canonical,
    ...(cover ? { image: `${SITE}/photos/${cover}-1600.jpg` } : {}),
    publisher: { '@type': 'Organization', name: 'Future Forward Studios', url: SITE, logo: { '@type': 'ImageObject', url: SITE + '/logo-icon.png' } } },
];
if (faq.length && !noindex) jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<Base title={d.seo_title || h1} description={d.meta_description || ''} canonical={canonical} noindex={noindex} ogType="article" ogImage={cover ? `/photos/${cover}-1600.jpg` : undefined} jsonld={jsonld}>
  <div class="wrap article-layout">
    <article class="article">
      <p class="crumbs"><a href="/">Home</a> <span aria-hidden="true">/</span> <span>{h1}</span></p>
      <p class="meta-line">{minutes} min read</p>
      {toc.length > 0 && <details class="toc-m"><summary>On this page</summary><ol>{toc.map((h: any) => <li><a href={'#' + h.slug}>{h.text}</a></li>)}</ol></details>}
      <div class="prose"><slot /></div>
      <aside class="byline-brand"><img src="/logo-primary.png" width="64" height="64" alt="Future Forward Studios logo" loading="lazy" /><p><strong>Future Forward Studios</strong><span>Practical, beginner-friendly guides for building things online. <a href="/about/">About us</a></span></p></aside>
    </article>
    <aside class="side">
      {toc.length > 0 && <nav class="toc" aria-label="On this page"><h2>On this page</h2><ol>{toc.map((h: any) => <li><a href={'#' + h.slug}>{h.text}</a></li>)}</ol></nav>}
    </aside>
  </div>
</Base>
